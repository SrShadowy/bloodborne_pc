#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# AppRun entry point for BBPort Native AppImage

set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

export APPDIR="$HERE"
export BB_PORT_DIR="$HERE"
export BB_PREBUILT=1
export PATH="$HERE/bin:$PATH"

export SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS=1
export SDL_JOYSTICK_HIDAPI=1
export SDL_JOYSTICK_HIDAPI_PS4=1
export SDL_JOYSTICK_HIDAPI_PS5=1
export SDL_JOYSTICK_ENHANCED_REPORTS=1

# Configure launcher backend: respect BB_LAUNCHER_BACKEND if set (x11 or wayland),
# otherwise inspect saved settings.json or CLI flags (--x11 / --wayland).
if [[ -z "${BB_LAUNCHER_BACKEND:-}" ]]; then
    _CFG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bbport-launcher/settings.json"
    if [[ -f "$_CFG_FILE" ]]; then
        if grep -q '"video_backend"[[:space:]]*:[[:space:]]*"x11"' "$_CFG_FILE" 2>/dev/null; then
            BB_LAUNCHER_BACKEND="x11"
        elif grep -q '"video_backend"[[:space:]]*:[[:space:]]*"wayland"' "$_CFG_FILE" 2>/dev/null; then
            BB_LAUNCHER_BACKEND="wayland"
        fi
    fi
fi

for _arg in "$@"; do
    if [[ "$_arg" == "--x11" ]]; then
        BB_LAUNCHER_BACKEND="x11"
    elif [[ "$_arg" == "--wayland" ]]; then
        BB_LAUNCHER_BACKEND="wayland"
    fi
done

if [[ "${BB_LAUNCHER_BACKEND:-}" == "x11" ]]; then
    export GDK_BACKEND="x11"
    export GSK_RENDERER="${GSK_RENDERER:-gl}"
elif [[ "${BB_LAUNCHER_BACKEND:-}" == "wayland" ]]; then
    export GDK_BACKEND="wayland"
    export GSK_RENDERER="${GSK_RENDERER:-gl}"
else
    export GSK_RENDERER="${GSK_RENDERER:-gl}"
fi

# Libraries bundled with package.py
if [[ -d "$HERE/lib" ]]; then
    export LD_LIBRARY_PATH="$HERE/lib:$HERE/bin/gpu:${LD_LIBRARY_PATH:-}"
else
    export LD_LIBRARY_PATH="$HERE/bin/gpu:${LD_LIBRARY_PATH:-}"
fi

# Shaders
if [[ -d "$HERE/fsr4_shaders" && -z "${BB_FSR4_SHADERS:-}" ]]; then
    export BB_FSR4_SHADERS="$HERE/fsr4_shaders"
fi

# XDG data directory configuration (~/.local/share/bbport)
export BB_DATA_DIR="${BB_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bbport}"
mkdir -p "$BB_DATA_DIR"
export BB_CONFIG="${BB_CONFIG:-$BB_DATA_DIR/bbport.ini}"

cd "$HERE"

# If Python 3 is installed on the host, delegate to the unified launcher entry point.
# It handles --play, --diagnostics, --version, --help, and prints clear [E-GTK-001] if GTK4/Adw is missing.
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$HERE/launcher/bbport_launcher.py" "$@"
fi

# Fallback when Python 3 is not installed on the host system:
if [[ -x "$HERE/launcher/bbport-launcher" ]]; then
    exec "$HERE/launcher/bbport-launcher" "$@"
elif [[ -x "$HERE/bin/bbport-launcher" ]]; then
    exec "$HERE/bin/bbport-launcher" "$@"
elif [[ -x "$HERE/bbport" ]]; then
    exec "$HERE/bbport" "$@"
else
    echo "================================================================="
    echo "Aviso: Python 3 não foi encontrado no sistema host."
    echo "Iniciando Bloodborne diretamente via run.sh..."
    echo "================================================================="
    exec "$HERE/run.sh" "$@"
fi
