#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform image2D img;
layout(binding = 1) uniform sampler1DArray lut;

layout(push_constant) uniform Constants {
    uint width;
    uint height;
    uint is_bgra;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) return;
    vec4 c = imageLoad(img, coord);
    if (pc.is_bgra != 0u) {
        float b = texture(lut, vec2(c.r, 2.0)).r;
        float g = texture(lut, vec2(c.g, 1.0)).r;
        float r = texture(lut, vec2(c.b, 0.0)).r;
        imageStore(img, coord, vec4(b, g, r, c.a));
    } else {
        float r = texture(lut, vec2(c.r, 0.0)).r;
        float g = texture(lut, vec2(c.g, 1.0)).r;
        float b = texture(lut, vec2(c.b, 2.0)).r;
        imageStore(img, coord, vec4(r, g, b, c.a));
    }
}
